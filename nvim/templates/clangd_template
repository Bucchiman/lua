CompileFlags:
  Add:
    - "-std=c++17"
    - "-I/usr/include"
    - "-I/usr/local/include"
  Remove:
    - "-W*"

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes

Hover:
  ShowAKA: Yes

Completion:
  AllScopes: Yes
